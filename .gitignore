.nsh/
target/
# Project-local cargo home (writable registry cache for the host-side driver,
# whose build is kept out of the app's iOS-default workspace).
.cargo-home/
# The host-side UI-test driver crate's build output.
android-ui-tests/target/
# Android native libs are cargo+NDK build outputs, regenerated by `make android-build`.
/android/app/src/main/jniLibs/
# Machine-specific: SDK path. The build uses ANDROID_HOME instead.
/android/local.properties
# Gradle build outputs.
/android/build/
/android/.gradle/
/android/app/build/
/android/runtime/build/
/android/app/.gradle/
/android/runtime/.gradle/
# Project-local Gradle user home (wrapper dist cache / build state).
/android/.gradle-home/
# Per-view screenshots captured by `make android-ui-tests`.
/android/snapshots/
/RustWrapper.app/simple
/RustWrapper.app/entitlements.plist
/RustWrapper.app/_CodeSignature/
