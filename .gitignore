.nsh/
target/
# The host-side UI-test driver is a member of the root workspace, so its build
# output lives in the shared target/ above. Android native libs are
# cargo+NDK build outputs, regenerated by `make android-build`.
/android/app/src/main/jniLibs/
/android/libs
# Machine-specific: SDK path. The build uses ANDROID_HOME instead.
/android/local.properties
# Gradle build outputs.
/android/build/
/android/.gradle/
/android/app/build/
/android/runtime/build/
/android/app/.gradle/
/android/runtime/.gradle/
# Project-local Gradle user home (wrapper dist cache / build state).
/android/.gradle-home/
# Prebuilt AAR from nsh-embed-android release.
/android/runtime/libs/nsh.aar
# Per-view screenshots captured by `make android-ui-tests`.
/android/snapshots/
/RustWrapper.app/simple
/RustWrapper.app/entitlements.plist
/RustWrapper.app/_CodeSignature/
/android/.cache/
